# Copy this file to backend/.env and fill in your values.
#   cp .env.example .env
# backend/.env is git-ignored, so your key never ends up in the repository.

# Your Claude (Anthropic) API key. Required for POST /ask; GET /summary works without it.
key_1=

# Which Claude model answers questions. Any current model that supports tool use works.
# See https://platform.claude.com/docs/en/models/overview
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional tuning (these are the defaults).
# LLM_EFFORT=medium            # low | medium | high, or "none" to use the model's default
# LLM_TEMPERATURE=             # leave empty: current models reject sampling parameters
# LLM_TIMEOUT_SECONDS=60       # per Claude call
# ASK_DEADLINE_SECONDS=120     # per question, all calls included
# LLM_MAX_TOKENS=8000          # per reply, thinking included
# MAX_TOOL_ROUNDS=4
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATA_DIR=../data
# LOG_DIR=logs
